    style B fill:#16213e,stroke:#0f3460,color:#eee
    style C fill:#0f3460,stroke:#533483,color:#eee
    style D fill:#533483,stroke:#e94560,color:#eee
    style E fill:#1a1a2e,stroke:#00d2ff,color:#eee
